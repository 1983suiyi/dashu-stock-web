# 复制为 .env 并填写真实值（.env 已被 .gitignore 忽略，不会入库）
# 生产部署请改用系统环境变量 / 密钥管理注入。

# 服务端口与监听地址
PORT=8787
HOST=0.0.0.0

# 管理员邮箱：该邮箱注册时免邀请码并自动获得 admin 角色
ADMIN_EMAIL=

# 邮件通道：console（控制台桩，验证码打印到日志） | brevo（真实发信）
MAIL_PROVIDER=console

# MAIL_PROVIDER=brevo 时必填：Brevo 事务邮件 API Key
BREVO_API_KEY=

# 发件人（需在 Brevo 后台验证过）。格式：显示名 <邮箱>
MAIL_FROM=大数选股 <no-reply@example.com>

# 生产 HTTPS 下设为 1，让会话 Cookie 带上 Secure 标记
COOKIE_SECURE=0
