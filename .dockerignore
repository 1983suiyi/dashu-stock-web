server/*.db
server/*.db-wal
server/*.db-shm
server/backups
server/*-cache.json

# 日志与临时文件
*.log
*.tsbuildinfo

# 文档与导出资料（不参与运行）
docs
scripts
*.md
大数投资_知识树.html
大数投资_知识简图.svg
大数投资_详细思维导图.html
